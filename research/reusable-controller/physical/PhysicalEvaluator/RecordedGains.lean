  | 1 => (0 / 1 : ℝ)
  | 2 => (0 / 1 : ℝ)
  | 3 => (0 / 1 : ℝ)
  | _ => (3730341748577201 / 50000000000000000 : ℝ)

theorem t6004p2Readout_eq (k : Fin 5) :
    reportedReadGain (t6004p2Q k) (t6004p2C k) (t6004p2Duration k) (t6004p2Kappa k) =
      t6004p2Gain k := by
  fin_cases k <;> rfl

/-- This margin is admissible headroom, not a measured sensor error. -/
theorem t6004p2ChargeMargin (k : Fin 5) :
    1 / 10 ≤ t6004p2C k - 1 / 10000000 ∧
      t6004p2C k + 1 / 10000000 ≤ 1 / 10 + 1 / 10000 := by
  fin_cases k <;> norm_num [t6004p2C]
theorem t6004p2DurationNonnegative (k : Fin 5) :
    0 ≤ t6004p2Duration k := by
  fin_cases k <;> norm_num [t6004p2Duration]
theorem t6004p2SignalPositive (k : Fin 5) :
    0 < t6004p2Q k - 1 / 10 - (t6004p2C k - 1 / 10) * Real.exp (-t6004p2Duration k) := by
  have charge : 0 ≤ t6004p2C k - 1 / 10 := by
    have margin := (t6004p2ChargeMargin k).1
    linarith
  have signal : 0 < t6004p2Q k - t6004p2C k := by
    fin_cases k <;> norm_num [t6004p2Q, t6004p2C]
  have decay : Real.exp (-t6004p2Duration k) ≤ 1 :=
    Real.exp_le_one_iff.mpr (neg_nonpos.mpr (t6004p2DurationNonnegative k))
  have correction := mul_le_mul_of_nonneg_left decay charge
  nlinarith
theorem t6004p2CorrectedPeak_eq (k : Fin 5) :
    correctedPeak (t6004p2Q k) (t6004p2C k) (t6004p2Duration k) (t6004p2Kappa k) =
      Real.exp (t6004p2Gain k) := by
  rw [correctedPeak_eq_exp_reportedReadGain (t6004p2SignalPositive k), t6004p2Readout_eq]
theorem t6004p2KappaScale (k : Fin 5) :
    Real.exp (t6004p2Kappa k) ≤ 11 / 10 := by
  have logBound := log_bounds_of_taylor 6 (x := (11 / 10 : ℝ))
    (lo := (9 / 100 : ℝ)) (hi := (1 / 10 : ℝ)) (by norm_num)
    (by norm_num [logTaylor, logTail, logArgument, Finset.sum_range_succ])
    (by norm_num [logTaylor, logTail, logArgument, Finset.sum_range_succ])
  have correction : t6004p2Kappa k ≤ 9 / 100 := by
    fin_cases k <;> norm_num [t6004p2Kappa]
  simpa only [Real.exp_log (by norm_num : (0 : ℝ) < 11 / 10)] using
    Real.exp_le_exp.mpr (correction.trans logBound.1)

noncomputable def t6004p2Ahat : ℝ := (127293 / 100000000 : ℝ)
noncomputable def t6004p2Bhat : ℝ := (573 / 125000 : ℝ)
theorem t6004p2Centre :
    |t6004p2Gain 0 - reportedCentre t6004p2NominalLevel0 t6004p2Dose0 4| ≤ t6004p2Ahat := by
  have g := t6004p2Gain_bounds 0
  have c : (-1744081 / 20000000 : ℝ) ≤ Real.log (t6004p2NominalLevel0 - 1/10) ∧
      Real.log (t6004p2NominalLevel0 - 1/10) ≤ (-2180101 / 25000000 : ℝ) := by
    apply log_bounds_of_taylor 6 (by norm_num [t6004p2NominalLevel0])
    all_goals norm_num [t6004p2NominalLevel0, logTaylor, logTail, logArgument, Finset.sum_range_succ]
  norm_num [t6004p2Lower, t6004p2Upper] at g
  dsimp [reportedCentre, t6004p2Ahat, t6004p2Dose0]
  exact abs_le.mpr ⟨by linarith [g.1, g.2, c.1, c.2], by linarith [g.1, g.2, c.1, c.2]⟩
theorem t6004p2Cumulative (k : Fin 5) :
    |t6004p2Gain k - t6004p2Gain 0 - (k.val : ℝ) * t6004p2Dose0| ≤ t6004p2Bhat := by
  have s := t6004p2Gain_bounds 0
  have g := t6004p2Gain_bounds k
  norm_num [t6004p2Gain, t6004p2Lower, t6004p2Upper] at s
  fin_cases k
  all_goals norm_num [t6004p2Gain, t6004p2Lower, t6004p2Upper] at g
  all_goals norm_num [t6004p2Gain, t6004p2Dose0, t6004p2Bhat]
  all_goals exact abs_le.mpr ⟨by linarith [s.1, s.2, g.1, g.2], by linarith [s.1, s.2, g.1, g.2]⟩
theorem t6004p2ResidualRoom :
    t6004p2Ahat + 1/10000 ≤ t6004p2A ∧ t6004p2Bhat + 2*(1/10000) ≤ t6004p2B := by
  norm_num [t6004p2Ahat, t6004p2Bhat, t6004p2A, t6004p2B]

end ReusableController.PhysicalEvaluator.RecordedGains
