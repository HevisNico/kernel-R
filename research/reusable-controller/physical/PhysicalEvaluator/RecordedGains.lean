  · exact t6004p2Read3_bounds
  · exact t6004p2Read4_bounds

noncomputable def t6004p2Q (k : Fin 5) : ℝ :=
  match k.val with
  | 0 => (44598565539 / 50000000000 : ℝ)
  | 1 => (57857800123 / 62500000000 : ℝ)
  | 2 => (120296124793 / 125000000000 : ℝ)
  | 3 => (994457461281 / 1000000000000 : ℝ)
  | _ => (969219855347 / 1000000000000 : ℝ)

noncomputable def t6004p2C (k : Fin 5) : ℝ :=
  match k.val with
  | 0 => (20007236783 / 200000000000 : ℝ)
  | 1 => (50016105947 / 500000000000 : ℝ)
  | 2 => (100033799137 / 1000000000000 : ℝ)
  | 3 => (25008792799 / 250000000000 : ℝ)
  | _ => (100036470973 / 1000000000000 : ℝ)

noncomputable def t6004p2Duration (k : Fin 5) : ℝ :=
  match k.val with
  | 0 => (1 / 2 : ℝ)
  | 1 => (1 / 2 : ℝ)
  | 2 => (1 / 2 : ℝ)
  | 3 => (1 / 2 : ℝ)
  | _ => (3 / 8 : ℝ)

noncomputable def t6004p2Kappa (k : Fin 5) : ℝ :=
  match k.val with
