import RecursiveLearning.Model

namespace RecursiveLearning.Example

def experiment : Experiment where
  initialLesson := ⟨4, 4⟩
  preparationCap := 2
  practiceCap := 2
  validation := [⟨3, 2⟩, ⟨2, 3⟩]

/-- These learners are not used by the selector or acceptance test. -/
def heldOut : List Learner :=
  [⟨3, 3⟩, ⟨2, 2⟩]

def initial : Memory := ⟨0, 0, false⟩
def first : Memory := ⟨1, 0, true⟩
def second : Memory := ⟨1, 1, true⟩
def frozenFirst : Memory := ⟨1, 0, false⟩

/-- Both improvements are generated by the update rule. The lessons cost
    8, 7 and 6 pulses respectively, and pass on fresh held-out learners. -/
theorem two_successive_improvements :
    experiment.step true initial = some first ∧
    experiment.step true first = some second ∧
    (experiment.lesson initial).cost = 8 ∧
    (experiment.lesson first).cost = 7 ∧
    (experiment.lesson second).cost = 6 ∧
    (experiment.lesson initial).passes heldOut = true ∧
    (experiment.lesson first).passes heldOut = true ∧
    (experiment.lesson second).passes heldOut = true := by
  decide

/-- Freezing just the selector retains the first improvement, changes the
    second proposed edit, and causes that edit to fail the skill check. -/
theorem frozen_selector_misses_second_improvement :
    experiment.step false initial = some frozenFirst ∧
    experiment.lesson frozenFirst = experiment.lesson first ∧
    experiment.propose frozenFirst = some ⟨2, 0, false⟩ ∧
    (experiment.lesson ⟨2, 0, false⟩).passes experiment.validation = false ∧
    experiment.step false frozenFirst = none := by
  decide

theorem accepted_trace : Run experiment true initial 2 second := by
  exact .cons two_successive_improvements.1
    (.cons two_successive_improvements.2.1 (.nil second))

theorem final_lesson_retains_iff (learner : Learner) :
    ((experiment.lesson second).train learner).retained = true ↔
      learner.preparationLeft ≤ 3 ∧ learner.practiceLeft ≤ 3 := by
  exact (experiment.lesson second).retained_iff learner

/-- Every lesson passing the fresh learner with needs (3, 3) costs at least
    as much as the final lesson. -/
theorem final_cost_optimal (lesson : Lesson)
    (retains : (lesson.train ⟨3, 3⟩).retained = true) :
    (experiment.lesson second).cost ≤ lesson.cost := by
  obtain ⟨preparation, practice⟩ := (lesson.retained_iff ⟨3, 3⟩).mp retains
  exact Nat.add_le_add preparation practice

/-- At six pulses a further practice reduction fails, although the memories
    retain unused capacity. Headroom is a bound, not an existence theorem. -/
theorem validation_stops_before_caps :
    experiment.propose second = some ⟨1, 2, true⟩ ∧
    (experiment.lesson ⟨1, 2, true⟩).passes experiment.validation = false ∧
    experiment.step true second = none ∧
    second.used < experiment.preparationCap + experiment.practiceCap := by
  decide

end RecursiveLearning.Example
