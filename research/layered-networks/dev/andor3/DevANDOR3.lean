def timing3 : SlotTiming := ⟨(12 / 5 : Rat), (18 / 5 : Rat), (23 / 5 : Rat)⟩
def node3_0 : Node 3 1 := ⟨{ canonical .copy with maxWrites := 5 }, fun a => if a.val = 0 then some 0 else none, fun _ => (3 / 25 : Rat), fun g => if g.val = 0 then pattern [0, 1] else pattern []⟩
def layer3 : Cascade 3 3 1 := .layer layer2 timing3 fun i => node3_0

