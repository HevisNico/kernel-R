def buildTrain : (c : Cascade M L N) → TrainingTrace c
  | .input => ()
  | .layer (L := L) lower _ _ => ⟨buildTrain lower,
      fun i g r => build lower (lessonRow (L + 1) i.val g.val r).2.1 (lessonRow (L + 1) i.val g.val r).2.2.1,
      fun i g r => (lessonRow (L + 1) i.val g.val r).2.2.2⟩
def train : TrainingTrace circuit := buildTrain circuit
def clock : LessonClock := fun l i g r => sched (lessonRow l i g r).1


theorem valid_check : checkLayeredValid circuit = true := by decide +kernel
theorem chain_check : checkChainDates (sched 0) (latencyLow dmin) (latencyHigh w lhigh) circuit = true := by decide +kernel
theorem test_scheduled : ((patterns 3).all fun y => let k := code y; checkScheduled (sched (testT k)) circuit (test k)) = true := by decide +kernel
theorem test_intrinsic : ((patterns 3).all fun y => let k := code y; checkIntrinsicDelays dmin dmax circuit (test k)) = true := by decide +kernel
theorem test_latency : ((patterns 3).all fun y => let k := code y; checkLatencies dmin lhigh circuit (test k)) = true := by decide +kernel
theorem test_routed : ((patterns 3).all fun y => let k := code y; routedAll circuit (test k)) = true := by decide +kernel
theorem test_output : ((patterns 3).all fun y => let k := code y; observed circuit (test k) 0 == expect k) = true := by decide +kernel
theorem test_predicted : ((patterns 3).all fun y => let k := code y; circuit.predict y 0 == expect k) = true := by decide +kernel
theorem test_external : ((patterns 3).all fun y => let k := code y; checkExternalWindow (sched (testT k) 0) w circuit (test k)) = true := by decide +kernel
theorem test_realised : ((patterns 3).all fun y => let k := code y; (List.finRange 3).all fun j => (inputTrace circuit (test k) j).isSome == y j) = true := by decide +kernel
theorem lesson_scheduled : checkTrainingScheduled clock circuit train = true := by decide +kernel
theorem lesson_chain : checkTrainingChainDates clock (latencyLow dmin) (latencyHigh w lhigh) circuit = true := by decide +kernel
theorem lesson_pulses : checkTrainingPulses clock (latencyLow dmin) (latencyHigh w lhigh) circuit train = true := by decide +kernel
