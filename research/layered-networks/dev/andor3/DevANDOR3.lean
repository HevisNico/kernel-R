def node1_0 : Node 3 3 := ⟨{ canonical .both with maxWrites := 5 }, fun a => if a.val = 0 then some 0 else some 1, fun _ => (3 / 25 : Rat), fun g => if g.val = 0 then pattern [0, 1, 2] else pattern []⟩
def node1_1 : Node 3 3 := ⟨{ canonical .copy with maxWrites := 4 }, fun a => if a.val = 0 then some 2 else none, fun _ => (3 / 25 : Rat), fun g => if g.val = 0 then pattern [0, 1, 2] else pattern []⟩
def layer1 : Cascade 3 1 2 := .layer (Cascade.input : Cascade 3 0 3) timing1 fun i => if i.val = 0 then node1_0 else node1_1

def timing2 : SlotTiming := ⟨(6 / 5 : Rat), (12 / 5 : Rat), (17 / 5 : Rat)⟩
def node2_0 : Node 3 2 := ⟨{ canonical .either with maxWrites := 4 }, fun a => if a.val = 0 then some 0 else some 1, fun _ => (3 / 25 : Rat), fun g => if g.val = 0 then pattern [0, 1] else pattern [2]⟩
