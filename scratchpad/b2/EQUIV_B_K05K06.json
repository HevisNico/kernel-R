{
 "all_identical_except_listed": false,
 "files_listed": [
  {
   "reason": "the instance's file list: follows the files above",
   "regex": "(.*/)?SHA256SUMS"
  },
  {
   "reason": "the driver's status file (steps' times, cores, mode)",
   "regex": "(.*/)?status\\.json"
  },
  {
   "reason": "the kernel build folder",
   "regex": "D/kernel(/.*)?"
  },
  {
   "reason": "trace extracts: compared through trace.digest.json",
   "regex": "N\\d/extract(/.*)?"
  },
  {
   "reason": "an older chain's extract file name",
   "regex": "N\\d/ref_extract\\.json"
  },
  {
   "reason": "the duplicate's wait log, written by campaign_run15 onwards and by campaign.py; campaign_run14 wrote none",
   "regex": "seal_wait\\.json"
  },
  {
   "reason": "deleted from the reference roots after their analysis (RAWS_DELETED_AFTER_ANALYSIS.txt); trace.digest.json is compared instead",
   "regex": "N0/trace\\.raw"
  }
 ],
 "format": "layered-equiv-b/1",
 "listed_rules": [
  {
   "name": "cost",
   "reason": "wall and CPU times (check_duplicate's exception)",
   "regex": ".*:(.*/)?(cost|wall_s|cpu_s|[^/]*_wall_s|[^/]*_cpu_s)(/.*)?"
  },
  {
   "name": "other_times",
   "reason": "other wall and CPU time fields (Lean's seconds, the inverter measures' machine time)",
   "regex": ".*:(.*/)?(cpu_min|seconds|seconds_total|machine_s|machine_s_total|wall_minutes|network_op_s)(/.*)?"
  },
  {
   "name": "date_line",
   "reason": "the trace's Date: line, as in check_duplicate",
   "regex": ".*:(.*/)?date_line(/.*)?"
  },
  {
   "name": "derived_hash",
   "reason": "the sha256 of another file of the same pair, which is itself compared here field by field (it differs only by listed fields: times, the ENV hash)",
   "regex": ".*:(.*/)?(inverter_gate/sha256|inverter_gate/source/sha256|prediction_sha256|instances/sha256|measure_sha256|extract/sha256|files/ngspice\\.log)"
  },
  {
   "name": "kernel_paths",
   "reason": "the absolute path of prediction.json given to Lean",
   "regex": "D/kernel/.*:(.*/)?prediction"
  },
  {
   "name": "times",
   "reason": "UTC dates of the run",
   "regex": ".*:(.*/)?(started|ended|at|time|utc|[^/]*_utc|pushed_at[^/]*|date)(/.*)?"
  },
  {
   "name": "env",
   "reason": "the ENV.json hash: ENV.json differs by its paths, uptime and the new `campaign` key",
   "regex": ".*:(.*/)?(env_sha256|env|ENV_sha256)(/.*)?"
  },
  {
   "name": "seal_log",
   "reason": "the seal-log commit: another log repository, another commit and time",
   "regex": ".*:(.*/)?(seal_log|record_seal_log|commit|line|seal_branch|branch|remote|seal_dir)(/.*)?"
  },
  {
   "name": "seal_sha",
   "reason": "the seal's hash, which follows the ENV hash sealed inside it",
   "regex": ".*:(.*/)?(seal_sha256|seal_sha|manifest_sha256|sha256sums_sha256)(/.*)?"
  },
  {
   "name": "seal_sums",
   "reason": "the seal's file list hashes and the push record, which follow the ENV hash and the log repository",
   "regex": "seal/SHA256SUMS:.*|N\\d/SEAL_LOG\\.json:.*|seal_push\\.json:.*"
  },
  {
   "name": "code",
   "reason": "hashes of the code files: another clone, and the chain's or campaign.py's driver",
   "regex": ".*:(.*/)?(code|code_sha256|driver[^/]*|[^/]*script[^/]*_sha256|sources)(/.*)?"
  },
  {
   "name": "kernel",
   "reason": "the kernel build reference (absent in stage_d5-era roots)",
   "regex": ".*:(.*/)?(kernel|kernel_build|kernel_[^/]*)(/.*)?"
  },
  {
   "name": "paths",
   "reason": "absolute paths of another root",
   "regex": ".*:(.*/)?(path|dir|root|out|cwd|argv|deck)(/.*)?"
  }
 ],
