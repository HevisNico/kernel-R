def case_standin_activity_force_push(tmp, src):
    r, res, obs = standin_run(tmp, src, "standin_activity_force_push", activity="force_push")
    return activity_mutation(r, obs), obs


def case_draw_same_machine_twice(tmp, src):
    roots = [draw_root(src, tmp / x / "out_K01", tmp, "out_K05", "PLAN_K01.json") for x in ("a", "b")]
    r, res, obs = run(tmp, roots, "draw_same_machine_twice", extra=[f"{DRAW_ARG}={DRAW}"])
    return refused(r) and "K01" in (r.stdout + r.stderr) and not_inflated(res, most=1), obs


def case_same_root_30_times(tmp, src):
    root = place(src / "out_K05", tmp / "a" / "out_K05", tmp)
    r, res, obs = run(tmp, [root] * 30, "same_root_30_times")
    established = res is not None and any(v[lv]["verdict"] == "established" for v in res["groups"].values()
                                          for lv in ("K0", "K3"))
    return refused(r) and not_inflated(res) and not established, obs


def case_same_machine_two_paths(tmp, src):
    roots = [place(src / "out_K05", tmp / "a" / "out_K05", tmp), place(src / "out_K05", tmp / "b" / "out_K05", tmp)]
    r, res, obs = run(tmp, roots, "same_machine_two_paths")
    return refused(r) and not_inflated(res), obs


def case_home_instance_twice(tmp, src):
    a = place(src / "out_K05", tmp / "a" / "out_K05", tmp)
    b = place(src / "out_K05", tmp / "a" / "out_K07", tmp, branch="evidence/devtest-seals2-K07")
    shutil.rmtree(b / "NOT1_6220")
    drop_lines(b, "NOT1_6220")
    old, new = b'"branch": "evidence/devtest-seals2-K05"', b'"branch": "evidence/devtest-seals2-K07"'
    for f in sorted((b / "NOT1_6212").glob("N*/**/noisy_record.json")):   # the records name their machine's seal branch
        if old in f.read_bytes():
            f.write_bytes(f.read_bytes().replace(old, new))
            redeclare(b, f.relative_to(b))

    def e(d):
        d["groups"]["NOT1"].update(seeds=[6212], d4_audit=[])
        d["what"] = "defect test D9: a copy of K05 without NOT1_6220, on its own seal branch (TEST)"
    edit_plan(b, e)
    r, res, obs = run(tmp, [a, b], "home_instance_twice")
    return refused(r) and not_inflated(res), obs


def case_one_byte_in_comparison(tmp, src):
    root = place(src / "out_K05", tmp / "a" / "out_K05", tmp)
    f = root / "NOT1_6212" / "N0" / "comparison.json"
    b = f.read_bytes()
    assert b.count(b'"cell_bits": 2') == 1
    f.write_bytes(b.replace(b'"cell_bits": 2', b'"cell_bits": 3'))
    r, res, obs = run(tmp, [root], "one_byte_in_comparison")
    return refused(r) and "N0/comparison.json" in (r.stdout + r.stderr), obs


def case_listed_file_missing(tmp, src):
    root = place(src / "out_K05", tmp / "a" / "out_K05", tmp)
    f = root / "NOT1_6212" / "N2" / "extract" / "extract.json"
    assert "N2/extract/extract.json" in (root / "NOT1_6212" / "SHA256SUMS").read_text()
    f.unlink()
    r, res, obs = run(tmp, [root], "listed_file_missing")
    return refused(r) and "extract.json" in (r.stdout + r.stderr), obs


# ------------------------------------------------------------------------------------------------ L: list exactness
# Rehearsal 2's list must be byte-equal to what [block rehearsal2-list] builds, and the campaign's to what [block list]
# builds from EXCLUDED_SECOND_SCAN.json and the two verified rehearsal draws; the scan must hold the pinned list. Each
# case runs on the FREEZE.txt blocks (extracted as proof2.py extracts them, never edited) and on analysis.py's own
# checks in the order its rehearsal and campaign modes call them: check_draw(kw, mode, ..., offline=True), then
# check_rehearsal_seeds(kw, info, ..., strict=False, mode). Both modes refuse the test roots before any draw check, so
# these two functions are called directly (in a subprocess).
#
# The fixture, built once per run:
# - rehearsal 1: its published DRAW.json (evidence/combined-rehearsal-draw-result at REHEARSAL1's result commit), its
#   EXCLUDED_PUBLISHED.json and DRAW_ANNOUNCE.txt (evidence/combined-rehearsal-draw), fetched by branch name;
# - EXCLUDED_REHEARSAL2.json, written by [block rehearsal2-list];
# - a stand-in rehearsal 2 (published quicknet round 34335000, 6/6/6, mode rehearsal) drawn over that list and announced
#   600 s before its round, after rehearsal 1's announce;
# - EXCLUDED_SECOND_SCAN.json, a twin of the scan's output: the pinned EXCLUDED.json plus SCAN_EXTRA (integers of 7
#   digits that no draw reads), count and seeds_sha256 recomputed;
# - EXCLUDED_SECOND.json, written by [block list];
# - a stand-in campaign draw (round 34340000, 60/32/37, mode campaign) over the case's campaign list.
# A mutated list is announced (its excluded_sha256) and its draw recomputed over it, so check_draw accepts it unless
# the mutation breaks the superset of the pinned list.
#
# The blocks run in bash with L (this tree), F (its HEAD), PY (this python) and python() set as in [block vars], in a
# working folder holding the fixture. A usercustomize.py on PYTHONPATH (the image's sitecustomize is left alone)
# replaces two reads, and only these, once analysis is imported:
# - check_draw called with offline=None in rehearsal or campaign mode (a GitHub read): offline=True and announce= the
#   fixture's DRAW_ANNOUNCE.txt of that draw. So the announce file and its push time are not read from GitHub
#   (announce_on_github), the announce branch name and N1 (freeze_time on research/layered-campaign-freeze) are not
#   checked; the announce's mode, sizes and excluded_sha256, the round, the signature and the recomputed draw are.
# - check_rehearsal_seeds called with strict=True: strict=False (its mode kept), with rehearsal_announce= and
#   rehearsal1_announce= the fixture's announces, so its two draws are checked offline the same way.
# The shim writes one line per replaced read to stderr ("shim: ..."), kept in the record.

ROUND_R2 = dict(round=34335000, randomness="95b68dcc123c90a03aa8609452cb45519c4ed8b054f6e94618455198f10a6fb1",
                signature="86a988abe179f2ea5f9a30f8ff7ee0ca2a6fd3e9245afff6b5d16fc8751ae6b49c58c017d565fa033f46f39ec77af4c7")
ROUND_C = dict(round=34340000, randomness="310a4ed5530b6496e3735158a8d814b106db3fafe3fc31fb4e6a5294cf48e77c",
               signature="a9e6f824268a56d68119afce3fa7e308ed6347e51ffba1fd08ff4f6663ce719811321472d66ca8a28fad244d5b792740")
CAMPAIGN_SIZES = dict(NOT1=60, ANDOR3=32, XOR3=37)
SCAN_EXTRA = (1234567, 2345678, 3456789)
SECOND_SCAN_ARG = "second_scan"                   # the fix's argument: second_scan=EXCLUDED_SECOND_SCAN.json
LIST_WRONG = "THE LIST IS WRONG"                  # the check blocks' verdict on a wrong list
LIST_RIGHT = "the list is right"
OLD_INCLUSION = ("excluded= list lacks",)         # check_rehearsal_seeds's inclusion check (before the fix)

SHIM = '''"""The defect tests' shim (tests/test_analysis_defects.py): two GitHub reads of analysis replaced offline."""
import importlib.machinery, inspect, json, os, sys
ANN = json.loads(os.environ["LAYERED_SHIM_ANNOUNCE"])


def patch(A):
    cd, crs = A.check_draw, A.check_rehearsal_seeds

    def check_draw(*a, **k):
        b = inspect.signature(cd).bind(*a, **k)
        b.apply_defaults()
        x = b.arguments
        if x["offline"] is None and x["mode"] != "test":
            x["kw"] = dict(x["kw"], announce=ANN[os.path.basename(x["kw"]["draw"])])
            x["offline"] = True
            print(f"shim: check_draw {os.path.basename(x['kw']['draw'])} {x['mode']}: offline, announce="
                  f"{os.path.basename(x['kw']['announce'])}", file=sys.stderr)
        return cd(*b.args, **b.kwargs)

    def check_rehearsal_seeds(*a, **k):
        b = inspect.signature(crs).bind(*a, **k)
        b.apply_defaults()
        x = b.arguments
        if x["strict"]:
            kw = dict(x["kw"])
            for pre in ("rehearsal_", "rehearsal1_"):
                if pre + "draw" in kw:
                    kw[pre + "announce"] = ANN[os.path.basename(kw[pre + "draw"])]
            x["kw"], x["strict"] = kw, False
            x["mode"] = x["mode"] if x["mode"] is not None else "campaign"
            print(f"shim: check_rehearsal_seeds {x['mode']}: strict=False, announces offline", file=sys.stderr)
        return crs(*b.args, **b.kwargs)

    A.check_draw, A.check_rehearsal_seeds = check_draw, check_rehearsal_seeds


class Hook:
    def find_spec(self, name, path=None, target=None):
        if name != "analysis":
            return None
        sys.meta_path.remove(self)
        spec = importlib.machinery.PathFinder.find_spec(name, path)
        run = spec.loader.exec_module

        def exec_module(m):
            run(m)
            patch(m)
        spec.loader.exec_module = exec_module
        return spec


sys.meta_path.insert(0, Hook())
'''

FUNCS = '''import json, sys, tempfile, traceback
sys.path.insert(0, sys.argv[1])
import analysis as A
a = json.loads(sys.argv[2])
out = dict(reached="check_draw")
try:
    d, info, _ = A.check_draw(a["kw"], a["mode"], tempfile.mkdtemp(), None, offline=True)
    out["reached"] = "check_rehearsal_seeds"
    A.check_rehearsal_seeds(a["kw"], info, tempfile.mkdtemp(), None, False, a["mode"])
    out.update(reached="accepted", refused=False)
except A.Refused as e:
    tb = traceback.extract_tb(e.__traceback__)
    names = [f.name for f in tb]
    out.update(refused=True, message=str(e), raised_in=names[-2] if len(names) > 1 else names[-1], stack=names,
               within=[n for n in names if n in ("check_draw", "check_rehearsal_seeds", "parse_announce")][-1:] or [None])
    out["within"] = out["within"][0]
print(json.dumps(out))
'''


def freeze_blocks():
    """[block NAME] ... [end] of FREEZE.txt, extracted as dev/freeze/final/proof2.py extracts them."""
    import re
    import textwrap
    text = (HERE / "FREEZE.txt").read_text().split("\n")
    blocks, k = {}, 0
    while k < len(text):
        m = re.fullmatch(r"\s*\[block ([a-z0-9-]+)\]\s*", text[k])
        if m:
            j = next(i for i in range(k + 1, len(text)) if text[i].strip() == "[end]")
            assert m.group(1) not in blocks, m.group(1)
            blocks[m.group(1)] = textwrap.dedent("\n".join(text[k + 1:j])) + "\n"
            k = j
        k += 1
    return blocks


def run_block(w, name, announces):
    """Run the block `name` verbatim in bash in the folder w, the shim on PYTHONPATH."""
    shim = w.parent / "shim"
    shim.mkdir(exist_ok=True)
    (shim / "usercustomize.py").write_text(SHIM)
    pre = (f'L={HERE}\nF=$(git -C "$L" rev-parse HEAD)\nPY={PY}\npython() {{ "$PY" "$@"; }}\n')
    env = dict(os.environ, PYTHONPATH=str(shim), LAYERED_SHIM_ANNOUNCE=json.dumps(announces))
    r = subprocess.run(["bash", "-c", pre + freeze_blocks()[name]], cwd=w, env=env, capture_output=True, text=True)
    return dict(block=name, exit=r.returncode, stdout=r.stdout[-1500:], stderr=r.stderr[-2500:])


def run_funcs(kw, mode):
    r = subprocess.run([PY, "-B", "-c", FUNCS, str(HERE), json.dumps(dict(kw=kw, mode=mode))], capture_output=True,
                       text=True)
    if r.returncode != 0 or not r.stdout.strip():
        return dict(crashed=True, exit=r.returncode, stderr=r.stderr[-1500:])
    return json.loads(r.stdout.strip().splitlines()[-1])


def regen(obj, seeds):
    sys.path.insert(0, str(HERE))
    import draw_seeds as DS
    seeds = sorted(set(seeds))
    return dict(obj, seeds=seeds, count=len(seeds), seeds_sha256=hashlib.sha256(DS.canon(seeds)).hexdigest())


LIST_BASE = {}


def list_base(tmp):
    """The shared fixture (see above), built once in the run's temporary folder."""
    if LIST_BASE:
        return LIST_BASE
    sys.path.insert(0, str(HERE))
    import analysis as A
    import draw_seeds as DS
    b = tmp.parent / "_list_base"
    b.mkdir()
    rep = b / "fetch"
    rep.mkdir()
    git("init", "-q", cwd=rep)
    r1 = A.REHEARSAL1
    git("fetch", "-q", origin_url(), f"refs/heads/{r1['result_branch']}", cwd=rep)
    assert git("rev-parse", "FETCH_HEAD", cwd=rep).strip() == r1["result_commit"], "rehearsal 1's result branch moved"
    (b / "DRAW_REHEARSAL1.json").write_bytes(subprocess.run(["git", "show", "FETCH_HEAD:DRAW.json"], cwd=rep,
                                                            check=True, capture_output=True).stdout)
    git("fetch", "-q", origin_url(), f"refs/heads/{r1['announce_branch']}", cwd=rep)
    for f, to in (("EXCLUDED_PUBLISHED.json", "EXCLUDED_REHEARSAL1.json"), ("DRAW_ANNOUNCE.txt", "ANNOUNCE_R1.txt")):
        (b / to).write_bytes(subprocess.run(["git", "show", f"FETCH_HEAD:{f}"], cwd=rep, check=True,
                                            capture_output=True).stdout)
    assert sha(b / "DRAW_REHEARSAL1.json") == r1["draw_sha256"] and sha(b / "EXCLUDED_REHEARSAL1.json") == \
        r1["excluded_sha256"], "rehearsal 1's published files are not the pinned ones"
    bb = run_block(b, "rehearsal2-list", {})
    assert bb["exit"] == 0, bb
    x2b = (b / "EXCLUDED_REHEARSAL2.json").read_bytes()
    R2, p2, t2 = announced_draw(b, "R2", ROUND_R2, json.loads(x2b), x2b, REHEARSAL_SIZES, "rehearsal",
                                "evidence/combined-rehearsal2-draw")
    shutil.copy(p2["draw"], b / "DRAW_REHEARSAL.json")
    shutil.copy(p2["announce"], b / "ANNOUNCE_R2.txt")
    pinned = json.loads((HERE / "EXCLUDED.json").read_bytes())
    assert not set(SCAN_EXTRA) & set(pinned["seeds"])
    (b / "EXCLUDED_SECOND_SCAN.json").write_bytes(DS.canon(regen(pinned, pinned["seeds"] + list(SCAN_EXTRA))))
    bl = run_block(b, "list", {})
    assert bl["exit"] == 0, bl
    rs1 = sorted(s for v in json.loads((b / "DRAW_REHEARSAL1.json").read_text())["groups"].values() for s in v)
    rs2 = sorted(s for v in R2["groups"].values() for s in v)
    LIST_BASE.update(dir=b, pinned=pinned, rs1=rs1, rs2=rs2, rehearsal2_push=t2, blocks=[bb, bl],
                     rehearsal2_list_sha256=sha(b / "EXCLUDED_REHEARSAL2.json"),
                     campaign_list_sha256=sha(b / "EXCLUDED_SECOND.json"))
    return LIST_BASE


def mutate(obj, kind, which, base):
    """The list `obj` with one mutation; seeds changes regenerate count and seeds_sha256."""
    seeds, pinned = list(obj["seeds"]), set(base["pinned"]["seeds"])
    rs = base["rs1"] if which == "rehearsal" else base["rs2"]
    note = None
    if kind == "extra":
        note = next(i for i in range(1000001, 9999999) if i not in seeds)
        return regen(obj, seeds + [note]), note
    if kind == "drop_noise":
        note = next(10 * s + j for s in rs for j in range(4) if 10 * s + j not in pinned and 10 * s + j in seeds)
    elif kind == "drop_scan":
        if which == "rehearsal":     # rehearsal 2's scan is the pinned list itself: a pinned seed, not of rehearsal 1
            ex1 = set(base["rs1"]) | {10 * s + j for s in base["rs1"] for j in range(4)}
            note = next(s for s in sorted(pinned) if s not in ex1)
        else:                        # one of the scan's own seeds beyond the pinned list
            note = SCAN_EXTRA[0]
    elif kind == "field":
        key = "rehearsal1_draw_sha256" if which == "rehearsal" else "rehearsal_draw_sha256"
        note = f"added.{key}"
        return dict(obj, added=dict(obj["added"], **{key: hashlib.sha256(b"another draw").hexdigest()})), note
    seeds.remove(note)
    return regen(obj, seeds), note


def list_case_files(tmp, which, kind):
    """A working folder with the fixture, the list of `which` mutated by `kind` (None: exact)."""
    base = list_base(tmp)
    import draw_seeds as DS
    w = tmp / "work"
    shutil.copytree(base["dir"], w, ignore=shutil.ignore_patterns("fetch"))
    name = "EXCLUDED_REHEARSAL2.json" if which == "rehearsal" else "EXCLUDED_SECOND.json"
    note = None
    if kind in ("extra", "drop_noise", "drop_scan", "field"):
        obj, note = mutate(json.loads((w / name).read_bytes()), kind, which, base)
        (w / name).write_bytes(DS.canon(obj))
    elif kind == "r2_extra":    # rehearsal 2's list with one extra integer, rehearsal 2 drawn and announced over it,
        r2 = w / "EXCLUDED_REHEARSAL2.json"   # and the campaign's list rebuilt by [block list] from that draw
        obj, note = mutate(json.loads(r2.read_bytes()), "extra", "rehearsal", base)
        r2.write_bytes(DS.canon(obj))
        _, p2, _ = announced_draw(w, "R2X", ROUND_R2, obj, r2.read_bytes(), REHEARSAL_SIZES, "rehearsal",
                                  "evidence/combined-rehearsal2-draw")
        shutil.copy(p2["draw"], w / "DRAW_REHEARSAL.json")
        shutil.copy(p2["announce"], w / "ANNOUNCE_R2.txt")
        (w / name).unlink()
        bl = run_block(w, "list", {})
        assert bl["exit"] == 0, bl
    return w, name, note


EXPECTED_CHECK = {
    "extra": "the new exactness check (the list byte-equal to the block's rebuild)",
    "field": "the new exactness check (the list byte-equal to the block's rebuild)",
    "drop_scan": "the new exactness check (1234567 is in the scan only, not pinned, not a rehearsal seed)",
    "drop_noise": "the new exactness check, or the existing inclusion check naming the seed",
    "no_scan": "the new check that second_scan= is given (blocks: the read of EXCLUDED_SECOND_SCAN.json)",
    "scan_short": "the new check that second_scan is a superset of the pinned EXCLUDED.json",
    "r2_extra": "the new exactness check of rehearsal_excluded= (rehearsal 2's list rebuilt from the pinned list and "
                "rehearsal 1's verified draw)",
}
EXPECTED_REHEARSAL_DROP_SCAN = "check_draw's existing superset check (the removed seed is in the pinned EXCLUDED.json)"


def list_facts(w, name, which, kind):
    """What the mutation recomputed, and the test's own check that the mutated list is self-consistent (count, sorted,
    no duplicate, seeds_sha256, the 20 % cap, and the pinned superset except where a pinned seed is removed), so that
    no count, hash or cap check can refuse it: only the content."""
    import draw_seeds as DS
    x = json.loads((w / name).read_bytes())
    pinned = set(LIST_BASE["pinned"]["seeds"])
    sup = set(x["seeds"]) >= pinned
    ok = (x["count"] == len(x["seeds"]) == len(set(x["seeds"])) and x["seeds"] == sorted(x["seeds"])
          and hashlib.sha256(DS.canon(x["seeds"])).hexdigest() == x["seeds_sha256"]
          and DS.excluded_fraction(x) <= DS.MAX_EXCLUDED_FRACTION
          and (sup or (which == "rehearsal" and kind == "drop_scan")))
    exp = (EXPECTED_REHEARSAL_DROP_SCAN if (which, kind) == ("rehearsal", "drop_scan") else EXPECTED_CHECK.get(kind))
    return dict(recomputed=(["count", "seeds_sha256"] if kind in ("extra", "drop_noise", "drop_scan") else
                            ["rehearsal 2's list: count, seeds_sha256; its draw and announce; the campaign's list by "
                             "[block list]"] if kind == "r2_extra" else []),
                list_sha256=sha(w / name), list_self_consistent=ok, pinned_superset=sup, expected_check=exp)


def list_block_case(which, kind):
    """kind: None (exact), extra, drop_noise, drop_scan, field, no_scan (EXCLUDED_SECOND_SCAN.json absent), scan_short
    (the scan without a pinned seed that rehearsal 1 drew: [block list] rebuilds the same bytes from it)."""
    def case(tmp, src):
        w, name, note = list_case_files(tmp, which, kind)
        obs = dict(list=name, mutation=kind, changed=note, **list_facts(w, name, which, kind))
        if kind == "no_scan":
            (w / "EXCLUDED_SECOND_SCAN.json").unlink()
        elif kind == "scan_unreadable":           # a directory in its place
            (w / "EXCLUDED_SECOND_SCAN.json").unlink()
            (w / "EXCLUDED_SECOND_SCAN.json").mkdir()
        elif kind == "scan_short":
            import draw_seeds as DS
            scan = json.loads((w / "EXCLUDED_SECOND_SCAN.json").read_bytes())
            obs["changed"] = drop = LIST_BASE["rs1"][0]
            (w / "EXCLUDED_SECOND_SCAN.json").write_bytes(DS.canon(regen(scan, [s for s in scan["seeds"] if s != drop])))
            (w / "EXCLUDED_SECOND.json").unlink()
            bl = run_block(w, "list", {})
            obs["rebuilt_list_equal"] = sha(w / "EXCLUDED_SECOND.json") == LIST_BASE["campaign_list_sha256"]
            if bl["exit"] != 0 or not obs["rebuilt_list_equal"]:
                return False, dict(obs, list_block=bl)
        ann = {"DRAW_REHEARSAL1.json": str(w / "ANNOUNCE_R1.txt"), "DRAW_REHEARSAL.json": str(w / "ANNOUNCE_R2.txt")}
        r = run_block(w, "check-rehearsal2-list" if which == "rehearsal" else "check-list", ann)
        obs.update(r, shim_lines=[x for x in r["stderr"].splitlines() if x.startswith("shim:")])
        key = ("blocks", which)
        if kind is None:
            LIST_CONTROL[key] = ok = r["exit"] == 0 and LIST_RIGHT in r["stdout"] and bool(obs["shim_lines"])
            return ok, obs
        obs["control_passed"] = LIST_CONTROL.get(key, False) and obs["list_self_consistent"]
        if kind in ("no_scan", "scan_unreadable"):   # an explicit refusal naming the file, no traceback
            own = (r["exit"] != 0 and LIST_RIGHT not in r["stdout"] and "Traceback" not in r["stderr"]
                   and "EXCLUDED_SECOND_SCAN.json" in r["stdout"] + r["stderr"])
        else:                         # the block's own verdict, or a refusal of the list check it calls (pinned below)
            own = (r["exit"] != 0 and (LIST_WRONG in r["stdout"] or "refused:" in r["stderr"])
                   and "Traceback" not in r["stderr"])
            if kind == "drop_noise":  # or, in [block check-list], check_rehearsal_seeds's inclusion check naming it
                own = own or (r["exit"] != 0 and any(o in r["stderr"] for o in OLD_INCLUSION) and str(note) in r["stderr"]
                              and "Traceback" not in r["stderr"])
        obs["reached_own_check"] = own
        err = r["stderr"].strip().splitlines()
        obs["message"] = next((x for x in err if x.startswith("refused:")), None) or \
            (err[-1] if "Traceback" in r["stderr"] else None) or (r["stdout"].strip().splitlines() or [None])[-1]
        return own and obs["control_passed"], obs
    case.__name__ = f"case_list_blocks_{which}_{kind}"
    return case


LIST_CONTROL = {}
LIST_MESSAGES = {}


def list_funcs_case(which, kind):
    """The same mutations through analysis.py's check_draw and check_rehearsal_seeds in rehearsal mode (which
    "rehearsal": draw= rehearsal 2, excluded= its list) or campaign mode (draw= the campaign stand-in, excluded= its
    list, second_scan= the scan; rehearsal_* and rehearsal1_* the two rehearsals)."""
    def case(tmp, src):
        w, name, note = list_case_files(tmp, which, kind)
        obs = dict(list=name, mutation=kind, changed=note, **list_facts(w, name, which, kind))
        eb = (w / name).read_bytes()
        if which == "rehearsal":
            D, p, t0 = announced_draw(w, "CASE", ROUND_R2, json.loads(eb), eb, REHEARSAL_SIZES, "rehearsal",
                                      "evidence/combined-rehearsal2-draw")
            kw = dict(draw=str(p["draw"]), excluded=str(p["excluded"]), announce=str(p["announce"]))
        else:
            scan_file = w / "EXCLUDED_SECOND_SCAN.json"
            if kind == "scan_short":
                import draw_seeds as DS
                scan = json.loads(scan_file.read_bytes())
                obs["changed"] = drop = LIST_BASE["rs1"][0]        # pinned, and drawn by rehearsal 1
                scan_file = w / "SCAN_SHORT.json"
                scan_file.write_bytes(DS.canon(regen(scan, [s for s in scan["seeds"] if s != drop])))
            fmt = campaign_announce_format()
            D, p, t0 = announced_draw(w, "CASE", ROUND_C, json.loads(eb), eb, CAMPAIGN_SIZES, "campaign",
                                      "evidence/combined-draw", fmt=fmt, second_scan_sha256=sha(scan_file))
            kw = dict(draw=str(p["draw"]), excluded=str(p["excluded"]), announce=str(p["announce"]),
                      rehearsal_draw=str(w / "DRAW_REHEARSAL.json"),
                      rehearsal_excluded=str(w / "EXCLUDED_REHEARSAL2.json"),
                      rehearsal_announce=str(w / "ANNOUNCE_R2.txt"))
            kw[SECOND_SCAN_ARG] = str(scan_file)
            obs.update(announce_format=fmt, announced_second_scan_sha256=sha(scan_file) if fmt in (2, "1s") else None)
            if kind == "no_scan":
                del kw[SECOND_SCAN_ARG]
        kw.update(rehearsal1_draw=str(w / "DRAW_REHEARSAL1.json"), rehearsal1_excluded=str(w / "EXCLUDED_REHEARSAL1.json"),
                  rehearsal1_announce=str(w / "ANNOUNCE_R1.txt"))
        obs["announced_excluded_sha256"] = [ln.split()[1] for ln in Path(p["announce"]).read_text().splitlines()
                                            if ln.startswith("excluded_sha256 ")][0]
        obs["announce_names_the_list"] = obs["announced_excluded_sha256"] == obs["list_sha256"]  # re-announced
        res = run_funcs(kw, which)
        obs.update(res, mode=which, args=sorted(kw))
        obs["earlier_checks_passed"] = res.get("reached") in ("check_rehearsal_seeds", "accepted")   # check_draw
        msg = res.get("message") or ""
        key = ("funcs", which)
        if kind is None:
            LIST_CONTROL[key] = ok = res.get("reached") == "accepted"
            return ok, obs
        obs["control_passed"] = (LIST_CONTROL.get(key, False) and obs["list_self_consistent"]
                                 and obs["announce_names_the_list"])
        old = any(o in msg for o in OLD_INCLUSION)
        if which == "rehearsal" and kind == "drop_scan":       # a pinned seed missing: check_draw's superset check
            own = res.get("within") == "check_draw" and "is not a superset of the freeze's EXCLUDED.json" in msg
        elif kind == "drop_noise":   # the exactness check, or the inclusion check naming the seed
            own = res.get("within") == "check_rehearsal_seeds" and (not old or str(note) in msg)
        elif kind in ("no_scan", "scan_short"):
            own = res.get("within") == "check_rehearsal_seeds" and SECOND_SCAN_ARG in msg and not old
        else:                        # extra, field, drop_scan (campaign): the exactness check, check_draw passed
            own = res.get("within") == "check_rehearsal_seeds" and not old and obs["earlier_checks_passed"]
        LIST_MESSAGES[(which, kind)] = msg
        if kind == "scan_short":     # its own check: not the one refusing an absent second_scan=
            own = own and msg != LIST_MESSAGES.get(("campaign", "no_scan"))
        if kind in ("no_scan", "scan_short", "r2_extra"):     # nor the campaign list's exactness check
            own = own and msg != LIST_MESSAGES.get(("campaign", "extra"))
        obs["reached_own_check"] = own
        return own and obs["control_passed"], obs
    case.__name__ = f"case_list_funcs_{which}_{kind}"
    return case


LIST_KINDS = {
    None: "the exact list (control): accepted",
    "extra": "one extra integer, count and seeds_sha256 recomputed: refused",
    "drop_noise": "one noise seed 10 S + j (not in the pinned list) removed, count and sha recomputed: refused",
    "drop_scan": "one scan seed removed, count and sha recomputed: refused",
    "field": "the \"added\" field's draw sha256 changed (a non-seed field): refused",
    "no_scan": "no EXCLUDED_SECOND_SCAN.json / no second_scan=: refused",
    "scan_short": "the scan without one pinned seed (one rehearsal 1 drew, so the rebuilt list is byte-equal): refused",
}
def campaign_announce_format():
    """2 (the spec); LAYERED_DEFECT_CAMPAIGN_ANNOUNCE=1s writes the campaign's announces as a5ba132b does (header /1,
    the fifth line second_scan_sha256), =1 as da3d9b3b does (/1, 4 lines), for code from before the /2 change
    (recorded in the report)."""
    v = os.environ.get("LAYERED_DEFECT_CAMPAIGN_ANNOUNCE", "2")
    return v if v == "1s" else int(v)


PARSE = '''import json, sys
sys.path.insert(0, sys.argv[1])
import analysis as A
try:
    print(json.dumps(dict(parsed=A.parse_announce(open(sys.argv[2], "rb").read()))))
except A.Refused as e:
    print(json.dumps(dict(refused=True, message=str(e))))
'''


def case_announce_rehearsal1_parses(tmp, src):
    """Rehearsal 1's real /1 announce (DRAW_ANNOUNCE.txt of evidence/combined-rehearsal-draw, fetched by name) parses
    with analysis.parse_announce: mode rehearsal, its published list's sha256, 6/6/6."""
    base = list_base(tmp)
    f = base["dir"] / "ANNOUNCE_R1.txt"
    r = subprocess.run([PY, "-B", "-c", PARSE, str(HERE), str(f)], capture_output=True, text=True)
    obs = dict(announce_sha256=sha(f), announce=f.read_text(), stderr=r.stderr[-800:])
    try:
        obs.update(json.loads(r.stdout.strip().splitlines()[-1]))
    except (ValueError, IndexError):
        return False, obs
    a = obs.get("parsed") or {}
    sys.path.insert(0, str(HERE))
    import analysis as A
    ok = (a.get("mode") == "rehearsal" and a.get("excluded_sha256") == A.REHEARSAL1["excluded_sha256"]
          and a.get("sizes") == REHEARSAL_SIZES and f.read_bytes().startswith(b"format layered-draw-announce/1\n"))
    return ok, obs


FORMAT_VARIANTS = {
    "campaign_v1": "a campaign announce with the header /1 and the line second_scan_sha256 (a5ba132b's form): refused",
    "campaign_v1_4lines": "a campaign announce in /1, 4 lines (no second_scan_sha256): refused",
    "rehearsal_v2": "a rehearsal announce in /2 (5 lines, with second_scan_sha256): refused",
    "campaign_v2_no_scan_sha": "a campaign announce in /2 without the line second_scan_sha256: refused",
    "campaign_v2_scan_sha_other": "a campaign announce in /2 whose second_scan_sha256 is not second_scan='s: refused",
    "campaign_v2_sha_nonhex": "a campaign announce in /2 whose excluded_sha256 is written in upper case: refused",
}


def format_case(variant):
    """The exact lists and draws of the L fixture, through check_draw + check_rehearsal_seeds, with one announce
    format changed. Gated on list_funcs_<mode>_exact."""
    which = "rehearsal" if variant.startswith("rehearsal") else "campaign"

    def case(tmp, src):
        w, name, _ = list_case_files(tmp, which, None)
        eb = (w / name).read_bytes()
        scan = w / "EXCLUDED_SECOND_SCAN.json"
        if which == "rehearsal":
            _, p, _ = announced_draw(w, "CASE", ROUND_R2, json.loads(eb), eb, REHEARSAL_SIZES, "rehearsal",
                                     "evidence/combined-rehearsal2-draw", fmt=2, second_scan_sha256=sha(scan))
            kw = dict(draw=str(p["draw"]), excluded=str(p["excluded"]), announce=str(p["announce"]))
        else:
            fmt, ssha = dict(campaign_v1=("1s", sha(scan)), campaign_v1_4lines=(1, sha(scan)),
                             campaign_v2_no_scan_sha=(2, None),
                             campaign_v2_scan_sha_other=(2, hashlib.sha256(b"another scan").hexdigest()),
                             campaign_v2_sha_nonhex=(2, sha(scan)))[variant]
            _, p, _ = announced_draw(w, "CASE", ROUND_C, json.loads(eb), eb, CAMPAIGN_SIZES, "campaign",
                                     "evidence/combined-draw", fmt=fmt, second_scan_sha256=ssha)
            kw = dict(draw=str(p["draw"]), excluded=str(p["excluded"]), announce=str(p["announce"]),
                      rehearsal_draw=str(w / "DRAW_REHEARSAL.json"), rehearsal_excluded=str(w / "EXCLUDED_REHEARSAL2.json"),
                      rehearsal_announce=str(w / "ANNOUNCE_R2.txt"), **{SECOND_SCAN_ARG: str(scan)})
        kw.update(rehearsal1_draw=str(w / "DRAW_REHEARSAL1.json"), rehearsal1_excluded=str(w / "EXCLUDED_REHEARSAL1.json"),
                  rehearsal1_announce=str(w / "ANNOUNCE_R1.txt"))
        if variant == "campaign_v2_sha_nonhex":
            t = Path(p["announce"]).read_text()
            h = hashlib.sha256(eb).hexdigest()
            Path(p["announce"]).write_text(t.replace(f"excluded_sha256 {h}", f"excluded_sha256 {h.upper()}"))
        res = run_funcs(kw, which)
        obs = dict(variant=variant, announce=Path(p["announce"]).read_text(), mode=which,
                   expected_check="the announce format check (parse_announce or check_draw)" if
                   variant != "campaign_v2_scan_sha_other" else "the check of second_scan_sha256 against second_scan=",
                   control_passed=LIST_CONTROL.get(("funcs", which), False), **res)
        msg = res.get("message") or ""
        if variant == "campaign_v2_scan_sha_other":
            own = (res.get("refused") is True and SECOND_SCAN_ARG + "=" in msg and "is not exactly the lines" not in msg
                   and not any(o in msg for o in OLD_INCLUSION))
        else:
            own = res.get("within") in ("parse_announce", "check_draw") and "announce" in msg.lower()
        obs["reached_own_check"] = own
        return own and obs["control_passed"], obs
    case.__name__ = f"case_format_{variant}"
    return case


LIST_KINDS["r2_extra"] = ("rehearsal_excluded= (rehearsal 2's list) with one extra integer, count and sha recomputed, "
                          "rehearsal 2 drawn and announced over it, the campaign list rebuilt from it: refused")
LIST_KINDS["scan_unreadable"] = "EXCLUDED_SECOND_SCAN.json a directory: an explicit refusal naming it, no traceback"
LIST_CASES = [(f"list_{side}_{which}_{kind or 'exact'}", which, kind, side)
              for side in ("blocks", "funcs") for which in ("rehearsal", "campaign")
              for kind in LIST_KINDS if (which == "campaign" or kind not in ("no_scan", "scan_short", "r2_extra"))
              and (side == "blocks" and which == "campaign" or kind != "scan_unreadable")]


# ------------------------------------------------------------------------------------------------ L: the scan itself
# The owner's decisions after the review of a5ba132b (spec relayed 2026-11-28): second_scan= must be draw_seeds.py
# scan's own output, self-consistent and canonical (one refusal each); a missing or unreadable scan is an explicit
# refusal naming the file; [block verify-scan], run on a second machine, reproduces the scan from its own ls-remote
# and [block announce] refuses unless its sha256 VS equals HS.

def rebuild_campaign_list(w, scan_obj):
    """[block list]'s rule, in the test: the scan plus both rehearsals' seeds and noise seeds, with "added" (bools of
    the scan are written as the integers they equal, so the list itself stays a list of integers)."""
    import draw_seeds as DS
    rb, rb1 = (w / "DRAW_REHEARSAL.json").read_bytes(), (w / "DRAW_REHEARSAL1.json").read_bytes()
    rs = sorted({s for b in (rb, rb1) for v in json.loads(b)["groups"].values() for s in v})
    noise = sorted(10 * s + n for s in rs for n in range(4))
    seeds = sorted({int(x) for x in scan_obj["seeds"]} | set(rs) | set(noise))
    out = dict(scan_obj, seeds=seeds, count=len(seeds), seeds_sha256=hashlib.sha256(DS.canon(seeds)).hexdigest(),
               added=dict(rehearsal_seeds=rs, noise_seeds=noise, rehearsal_draw_sha256=hashlib.sha256(rb).hexdigest(),
                          rehearsal1_draw_sha256=hashlib.sha256(rb1).hexdigest()))
    return DS.canon(out)


def scan_variant(obj, variant):
    """The bytes of the scan with exactly one defect; everything else valid (count and seeds_sha256 recomputed over
    the seeds as written, except in the cases on those two fields)."""
    import draw_seeds as DS
    sha_of = lambda seeds: hashlib.sha256(DS.canon(seeds)).hexdigest()
    o = json.loads(json.dumps(obj))
    if variant == "noncanon":
        return (json.dumps(o, sort_keys=True, indent=1) + "\n").encode()
    if variant == "format":
        o["format"] = "layered-excluded-seeds/0"
    elif variant == "rule":
        o["rule"] = o["rule"] + " (edited)"
    elif variant in ("unsorted", "duplicate", "bool"):
        s = list(o["seeds"])
        if variant == "unsorted":
            s[0], s[1] = s[1], s[0]
        elif variant == "duplicate":
            s.insert(1, s[0])
        else:                            # 0 or 1 written as the bool it equals
            v = 0 if 0 in s else 1
            s[s.index(v)] = bool(v)
        o.update(seeds=s, count=len(s), seeds_sha256=sha_of(s))
    elif variant == "count":
        o["count"] += 1
    elif variant == "seeds_sha256":
        o["seeds_sha256"] = sha_of(o["seeds"] + [9999999])
    elif variant == "refs_malformed":
        k = next(k for k in sorted(o["refs"]) if k != "HEAD")
        o["refs"][k] = dict(tip="not a tip", numbers=o["refs"][k].get("numbers", 0))
    elif variant == "refs_no_head":
        del o["refs"]["HEAD"]
    elif variant == "head_not_main":       # HEAD at another ref's tip
        k = next(k for k in sorted(o["refs"]) if k != "HEAD" and not k.endswith("/main")
                 and o["refs"][k].get("tip") != o["refs"]["HEAD"].get("tip"))
        o["refs"]["HEAD"] = dict(o["refs"]["HEAD"], tip=o["refs"][k]["tip"])
    elif variant == "refs_duplicate":       # canonical bytes with one ref name written twice
        b = DS.canon(o).decode()
        k = next(k for k in sorted(o["refs"]) if k != "HEAD")
        entry = json.dumps({k: o["refs"][k]}, sort_keys=True, separators=(",", ":"))[1:-1]
        return b.replace(entry, entry + "," + entry, 1).encode()
    return DS.canon(o)


SCAN_VARIANTS = {
    "noncanon": "the scan's bytes are not draw_seeds.canon of its JSON (indented)",
    "format": "its format is not draw_seeds.py scan's",
    "rule": "its rule text is not draw_seeds.py scan's",
    "unsorted": "two seeds swapped (count and seeds_sha256 recomputed over them)",
    "duplicate": "one seed written twice (count and seeds_sha256 recomputed)",
    "bool": "the seed 0 (or 1) written as false (true) (count and seeds_sha256 recomputed)",
    "count": "count one more than the seeds",
    "seeds_sha256": "seeds_sha256 of other seeds",
    "refs_malformed": "one ref's tip is not a commit sha",
    "refs_duplicate": "one ref name written twice in the bytes",
    "refs_no_head": "no HEAD entry in refs",
    "head_not_main": "HEAD's tip is another ref's, not main's",
}
SCAN_MESSAGES = {}


def scan_case(variant):
    """Campaign mode through check_draw + check_rehearsal_seeds: second_scan= the scan with one defect, the announce
    naming its sha256, excluded= rebuilt from it by [block list]'s rule and the draw over that list. Must be refused,
    in check_rehearsal_seeds (or a helper), with a message naming second_scan= that no other variant gives and that is
    not the exact union's. Gated on list_funcs_campaign_exact."""
    def case(tmp, src):
        w, name, _ = list_case_files(tmp, "campaign", None)
        sb = scan_variant(json.loads((w / "EXCLUDED_SECOND_SCAN.json").read_bytes()), variant)
        (w / "SCAN_X.json").write_bytes(sb)
        (w / name).write_bytes(rebuild_campaign_list(w, json.loads(sb)))
        eb = (w / name).read_bytes()
        fmt = campaign_announce_format()
        _, p, _ = announced_draw(w, "CASE", ROUND_C, json.loads(eb), eb, CAMPAIGN_SIZES, "campaign",
                                 "evidence/combined-draw", fmt=fmt, second_scan_sha256=sha(w / "SCAN_X.json"))
        kw = dict(draw=str(p["draw"]), excluded=str(p["excluded"]), announce=str(p["announce"]),
                  rehearsal_draw=str(w / "DRAW_REHEARSAL.json"), rehearsal_excluded=str(w / "EXCLUDED_REHEARSAL2.json"),
                  rehearsal_announce=str(w / "ANNOUNCE_R2.txt"), rehearsal1_draw=str(w / "DRAW_REHEARSAL1.json"),
                  rehearsal1_excluded=str(w / "EXCLUDED_REHEARSAL1.json"), rehearsal1_announce=str(w / "ANNOUNCE_R1.txt"),
                  **{SECOND_SCAN_ARG: str(w / "SCAN_X.json")})
        res = run_funcs(kw, "campaign")
        msg = res.get("message") or ""
        import re
        SCAN_MESSAGES[variant] = re.sub(r"second_scan= \S+?(:| is | names )", r"second_scan= <path>\1", msg)
        obs = dict(variant=variant, defect=SCAN_VARIANTS[variant], scan_sha256=sha(w / "SCAN_X.json"),
                   announce_format=fmt, expected_check="the second scan's own check: " + SCAN_VARIANTS[variant],
                   control_passed=LIST_CONTROL.get(("funcs", "campaign"), False), **res)
        own = (res.get("within") == "check_rehearsal_seeds" and SECOND_SCAN_ARG in msg and CU not in msg
               and not any(o in msg for o in OLD_INCLUSION))
        if variant == list(SCAN_VARIANTS)[-1]:      # the last: one message per class of defect (the owner's list:
            # unsorted and duplicated seeds are one class, "seeds are not sorted and unique")
            cls = {v: ("unsorted" if v == "duplicate" else v) for v in SCAN_VARIANTS}
            by = {}
            for v in SCAN_VARIANTS:
                by.setdefault(cls[v], set()).add(SCAN_MESSAGES.get(v))
            msgs = [m for ms in by.values() for m in ms]
            obs["messages_distinct"] = (None not in msgs and all(len(ms) == 1 for ms in by.values())
                                        and len(set(msgs)) == len(by))
            own = own and obs["messages_distinct"]
        obs["reached_own_check"] = own
        return own and obs["control_passed"], obs
    case.__name__ = f"case_scan_{variant}"
    return case


def scan_file_case(kind):
    """second_scan= missing (a path that does not exist) or unreadable (a directory): an explicit refusal naming the
    file, no traceback. Gated on list_funcs_campaign_exact."""
    def case(tmp, src):
        w, name, _ = list_case_files(tmp, "campaign", None)
        eb = (w / name).read_bytes()
        fmt = campaign_announce_format()
        _, p, _ = announced_draw(w, "CASE", ROUND_C, json.loads(eb), eb, CAMPAIGN_SIZES, "campaign",
                                 "evidence/combined-draw", fmt=fmt, second_scan_sha256=sha(w / "EXCLUDED_SECOND_SCAN.json"))
        bad = w / ("NO_SUCH_SCAN.json" if kind == "missing" else "SCAN_DIR.json")
        if kind == "unreadable":
            bad.mkdir()
        kw = dict(draw=str(p["draw"]), excluded=str(p["excluded"]), announce=str(p["announce"]),
                  rehearsal_draw=str(w / "DRAW_REHEARSAL.json"), rehearsal_excluded=str(w / "EXCLUDED_REHEARSAL2.json"),
                  rehearsal_announce=str(w / "ANNOUNCE_R2.txt"), rehearsal1_draw=str(w / "DRAW_REHEARSAL1.json"),
                  rehearsal1_excluded=str(w / "EXCLUDED_REHEARSAL1.json"), rehearsal1_announce=str(w / "ANNOUNCE_R1.txt"),
                  **{SECOND_SCAN_ARG: str(bad)})
        res = run_funcs(kw, "campaign")
        msg = res.get("message") or ""
        if res.get("crashed"):
            res["message"] = (res.get("stderr") or "").strip().splitlines()[-1:] or [None]
            res["message"] = res["message"][0]
        obs = dict(kind=kind, file=bad.name, control_passed=LIST_CONTROL.get(("funcs", "campaign"), False),
                   expected_check="an explicit refusal naming the file", **res)
        own = res.get("refused") is True and bad.name in msg and not res.get("crashed")
        obs["reached_own_check"] = own
        return own and obs["control_passed"], obs
    case.__name__ = f"case_scan_file_{kind}"
    return case


# [block verify-scan]: a local twin of the repository (no network), whose scan holds the pinned list
VS_BRANCHES = ("main", "evidence/twin-a", "evidence/twin-b")
VS_BASE = {}


def twin_repository(tmp):
    """A bare repository with VS_BRANCHES. main holds pinned_seeds.txt, one line "seed NNNNNNN" (7 digits, zero
    padded) per seed of the pinned EXCLUDED.json, so that its scan is a superset of the pinned list; the two other
    branches each add one file with other integers. Its main commit's author is a test identity."""
    bare, work = tmp / "twin.git", tmp / "twin_work"
    git("init", "-q", "--bare", str(bare))
    git("init", "-q", "-b", "main", str(work))
    ident = ["-c", "user.name=defect test", "-c", "user.email=defect-test@localhost"]
    pinned = json.loads((HERE / "EXCLUDED.json").read_bytes())["seeds"]
    (work / "pinned_seeds.txt").write_text("".join(f"seed {s:07d}\n" for s in pinned))
    git("add", ".", cwd=work)
    git(*ident, "commit", "-q", "-m", "twin main", cwd=work)
    for k, br in enumerate(VS_BRANCHES[1:]):
        git("checkout", "-q", "-b", br, "main", cwd=work)
        (work / f"twin_{k}.txt").write_text(f"seed {7654321 - k}\nnoise_seed {6543210 - k}\n")
        git("add", ".", cwd=work)
        git(*ident, "commit", "-q", "-m", f"twin {br}", cwd=work)
    git("push", "-q", str(bare), *[f"{b}:refs/heads/{b}" for b in VS_BRANCHES], cwd=work)
    git("symbolic-ref", "HEAD", "refs/heads/main", cwd=bare)
    return bare


def twin_env(tmp, bare):
    cfg = tmp / "gitconfig"
    cfg.write_text(f'[url "file://{bare}"]\n\tinsteadOf = https://github.com/HevisNico/kernel-R\n')
    return dict(os.environ, GIT_CONFIG_GLOBAL=str(cfg), GIT_CONFIG_NOSYSTEM="1", GIT_ALLOW_PROTOCOL="file")


def bash_blocks(w, env, names, fill, extra=()):
    """Run blocks verbatim, in one bash, after the vars preamble and [block vars-campaign] with its placeholders
    filled by fill(name, description) (None: an unknown placeholder, recorded)."""
    import re
    blocks = freeze_blocks()
    missing = [n for n in names if n not in blocks]
    lines, unknown = [], []
    for ln in blocks["vars-campaign"].splitlines():
        m = re.fullmatch(r"(\w+)=<([^>]*)>\s*", ln)
        if m:
            v = fill(m.group(1), m.group(2))
            if v is None:
                unknown.append(ln)
            ln = f"{m.group(1)}={v}"
        lines.append(ln)
    if missing:
        return None, dict(missing_blocks=missing, unknown_placeholders=unknown)
    pre = (f'L={HERE}\nF=$(git -C "$L" rev-parse HEAD)\nPY={PY}\npython() {{ "$PY" "$@"; }}\n' + "\n".join(lines)
           + "\n" + "".join(x + "\n" for x in extra))
    r = subprocess.run(["bash", "-c", pre + "".join(blocks[n] for n in names)], cwd=w, env=env, capture_output=True,
                       text=True)
    return r, dict(blocks=names, exit=r.returncode, stdout=r.stdout[-1500:], stderr=r.stderr[-1500:],
                   unknown_placeholders=unknown)


def vs_base(tmp):
    """The twin, and its scan reproduced by [block second-scan] verbatim (the canonical scan of the twin)."""
    if VS_BASE:
        return VS_BASE
    base = list_base(tmp)
    root = tmp.parent / "_vs_base"
    root.mkdir()
    bare = twin_repository(root)
    env = twin_env(root, bare)
    w = root / "scan"
    w.mkdir()
    r, obs = bash_blocks(w, env, ["second-scan"], lambda n, d: "0" * 64)
    assert r is not None and r.returncode == 0, obs
    scan = json.loads((w / "EXCLUDED_SECOND_SCAN.json").read_bytes())
    assert set(base["pinned"]["seeds"]) <= set(scan["seeds"]), "the twin's scan does not hold the pinned list"
    VS_BASE.update(bare=bare, env=env, scan=(w / "EXCLUDED_SECOND_SCAN.json").read_bytes(),
                   scan_sha256=sha(w / "EXCLUDED_SECOND_SCAN.json"), refs=sorted(scan["refs"]))
    return VS_BASE


VS_KINDS = {
    None: "the twin's scan as [block second-scan] makes it (control): verify-scan passes, VS = HS",
    "plus3": "the canonical scan plus 3 integers, count and seeds_sha256 recomputed (the owner's acceptance case): "
             "verify-scan fails before any announce commit, and [block announce] refuses",
    "omit_branch": "the scan without one branch's ref entry: verify-scan fails",
    "wrong_tip": "one ref with another commit's tip: verify-scan fails",
}
VS_CONTROL = {}


def verify_scan_case(kind):
    """The implementer's interface (13ebca8b): on the second machine, a fresh folder: [block second-scan] verbatim on
    a fresh copy of the twin, SCAN_TO_VERIFY.json the case's scan, then [block verify-scan] verbatim. It prints
    VERIFY.txt, whose final line carries " VS <64hex>". Exact: exit 0, "the scan is reproduced", VS = HS, one push to
    the twin's evidence/combined-scan-verify. Doctored: exit 1, "THE SCAN IS NOT REPRODUCED", no push. plus3 then runs
    [block announce] on the first machine's folder with HS its scan's sha256 and VS the printed one: refused before any
    ls-remote, mkdir or commit."""
    def case(tmp, src):
        import draw_seeds as DS
        import re
        vb = vs_base(tmp)
        bare = tmp / "twin.git"
        shutil.copytree(vb["bare"], bare)
        env = twin_env(tmp, bare)
        w, name, _ = list_case_files(tmp, "campaign", None)
        o = json.loads(vb["scan"])
        if kind == "plus3":
            have = set(o["seeds"])
            extra = [i for i in range(1000001, 1000100) if i not in have][:3]
            o = regen(o, o["seeds"] + extra)
        elif kind == "omit_branch":
            del o["refs"][next(k for k in o["refs"] if k.endswith("twin-a"))]
        elif kind == "wrong_tip":
            k = next(k for k in o["refs"] if k.endswith("twin-b"))
            o["refs"][k]["tip"] = o["refs"][next(k2 for k2 in o["refs"] if k2.endswith("twin-a"))]["tip"]
        sb = DS.canon(o)
        (w / "EXCLUDED_SECOND_SCAN.json").write_bytes(sb)      # the first machine's folder
        (w / name).unlink()
        bl = run_block(w, "list", {})
        hs = hashlib.sha256(sb).hexdigest()
        m2 = tmp / "second_machine"
        m2.mkdir()
        dummy = lambda n, d: "0" * 64
        r2, o2 = bash_blocks(m2, env, ["second-scan"], dummy)
        (m2 / "SCAN_TO_VERIFY.json").write_bytes(sb)
        r, obs = bash_blocks(m2, env, ["verify-scan"], dummy)
        obs.update(kind=kind, list_block_exit=bl["exit"], second_scan_exit=r2.returncode if r2 else None, HS=hs,
                   expected_check=VS_KINDS[kind])
        if r is None:
            return False, obs
        vt = (m2 / "VERIFY.txt").read_text() if (m2 / "VERIFY.txt").exists() else r.stdout
        last = (vt.strip().splitlines() or [""])[-1]
        m = re.search(r" VS ([0-9a-f]{64})\b", last)
        vs = m.group(1) if m else None
        pushed_verify = subprocess.run(["git", "-C", str(bare), "rev-parse", "-q", "--verify",
                                        "refs/heads/evidence/combined-scan-verify"], capture_output=True).returncode == 0
        obs.update(VS=vs, final_line=last, problems=[x for x in vt.splitlines() if x.startswith("PROBLEM:")],
                   verify_pushed_to_twin=pushed_verify, message=last)
        if kind is None:
            VS_CONTROL["ok"] = ok = (r.returncode == 0 and last.startswith("the scan is reproduced") and vs == hs
                                     and pushed_verify)
            return ok, obs
        obs["control_passed"] = VS_CONTROL.get("ok", False)
        ok = r.returncode == 1 and last.startswith("THE SCAN IS NOT REPRODUCED") and not pushed_verify and vs != hs
        if kind == "plus3":            # the announce, with VS != HS, refuses before any ls-remote, mkdir or commit
            fill = lambda n, d: sha(w / name) if n == "H" else hs if n == "HS" else vs if n == "VS" else None
            ra, oa = bash_blocks(w, env, ["announce"], fill)
            pushed = subprocess.run(["git", "-C", str(bare), "rev-parse", "-q", "--verify",
                                     "refs/heads/evidence/combined-draw"], capture_output=True).returncode == 0
            oa.update(announce_folder_made=(w / "announce_campaign").exists(), pushed_to_twin=pushed)
            obs["announce"] = oa
            obs["message"] = next((x for x in (ra.stdout if ra else "").splitlines() if "REFUSED" in x), None)
            ok = (ok and ra is not None and ra.returncode != 0 and (obs["message"] or "").startswith("REFUSED: VS (")
                  and not oa["announce_folder_made"] and not pushed and not oa["unknown_placeholders"])
        obs["refused_before_announce"] = ok
        return ok and obs["control_passed"], obs
    case.__name__ = f"case_verify_scan_{kind or 'exact'}"
    return case


PRE = '''import datetime, json, sys, tempfile, traceback
sys.path.insert(0, sys.argv[1])
import analysis as A
a = json.loads(sys.argv[2])
now = datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
extra = dict(pre_announce=True) if a["pre_announce"] else {}
try:
    A.check_rehearsal_seeds(a["kw"], dict(announce=dict(push_utc=now)), tempfile.mkdtemp(), None, False, "campaign",
                            **extra)
    print(json.dumps(dict(refused=False)))
except A.Refused as e:
    print(json.dumps(dict(refused=True, message=str(e))))
'''


def pre_announce_case(given):
    """check_rehearsal_seeds as [block check-list] calls it, before the announce (draw_info has only a push time, no
    second_scan_sha256): with pre_announce=True accepted (control), without it refused."""
    def case(tmp, src):
        w, name, _ = list_case_files(tmp, "campaign", None)
        kw = dict(excluded=str(w / name), rehearsal_draw=str(w / "DRAW_REHEARSAL.json"),
                  rehearsal_excluded=str(w / "EXCLUDED_REHEARSAL2.json"), rehearsal_announce=str(w / "ANNOUNCE_R2.txt"),
                  rehearsal1_draw=str(w / "DRAW_REHEARSAL1.json"), rehearsal1_excluded=str(w / "EXCLUDED_REHEARSAL1.json"),
                  rehearsal1_announce=str(w / "ANNOUNCE_R1.txt"), **{SECOND_SCAN_ARG: str(w / "EXCLUDED_SECOND_SCAN.json")})
        r = subprocess.run([PY, "-B", "-c", PRE, str(HERE), json.dumps(dict(kw=kw, pre_announce=given))],
                           capture_output=True, text=True)
        try:
            res = json.loads(r.stdout.strip().splitlines()[-1])
        except (ValueError, IndexError):
            return False, dict(crashed=True, stderr=r.stderr[-1500:])
        obs = dict(pre_announce=given, **res)
        if given:
            PRE_CONTROL["ok"] = ok = res.get("refused") is False
            return ok, obs
        obs["control_passed"] = PRE_CONTROL.get("ok", False)
        return res.get("refused") is True and obs["control_passed"], obs
    case.__name__ = f"case_pre_announce_{'given' if given else 'absent'}"
    return case


PRE_CONTROL = {}


def case_cli_pre_announce(tmp, src):
    """`analysis.py test OUT ROOT pre_announce=True` (the internal argument on the command line): refused as an
    unknown argument."""
    root = tmp / "root"
    root.mkdir()
    r = subprocess.run([PY, "-B", str(ANALYSIS), "test", str(tmp / "out"), str(root), "pre_announce=True"],
                       capture_output=True, text=True, cwd=tmp)
    text = r.stdout + r.stderr
    msg = next((x for x in text.splitlines() if "refused" in x), text.strip()[-300:])
    return r.returncode != 0 and "unknown argument 'pre_announce=True'" in text, dict(exit=r.returncode, message=msg)


# The scan verify record (the implementer's interface at 7fa3693e): four files (VERIFY_FILES) on the single creation
# commit of evidence/combined-scan-verify. The AUTHENTIC record is made by the blocks themselves, on a fresh twin per
# case: [block second-scan] then [block verify-scan], verbatim, in a second-machine folder (their push goes to the
# twin). The record branch's history, which GitHub keeps, is the twin's ACTIVITY/<branch, "/" as "__">.json, written
# by the test (analysis.record_created reads it for a path remote). Doctored records are the authentic commit with
# files changed, amended (one commit still) and put on the twin by a local push.
# [block announce] reads the record from its literal https://github.com/HevisNico/kernel-R. Its git commands reach
# the twin by url.insteadOf; its two record reads (analysis.scan_verify_record and analysis.record_created) are given
# the twin's path by a usercustomize.py shim (TWIN_SHIM, nothing else replaced), so that no GitHub API is asked.
VERIFY_BRANCH = "evidence/combined-scan-verify"
GITHUB_URL = "https://github.com/HevisNico/kernel-R"
TWIN_SHIM = '''"""The defect tests' twin shim: analysis's two record reads on the GitHub URL go to the twin's path."""
import importlib.machinery, os, sys
TWIN, URL = os.environ["LAYERED_TWIN_REMOTE"], "https://github.com/HevisNico/kernel-R"


def patch(A):
    for name in ("scan_verify_record", "record_created"):
        f = getattr(A, name)

        def g(remote, *a, _f=f, _n=name, **k):
            if remote == URL:
                print(f"twin shim: {_n} reads {TWIN}", file=sys.stderr)
                remote = TWIN
            return _f(remote, *a, **k)
        setattr(A, name, g)


class Hook:
    def find_spec(self, name, path=None, target=None):
        if name != "analysis":
            return None
        sys.meta_path.remove(self)
        spec = importlib.machinery.PathFinder.find_spec(name, path)
        run = spec.loader.exec_module

        def exec_module(m):
            run(m)
            patch(m)
        spec.loader.exec_module = exec_module
        return spec


sys.meta_path.insert(0, Hook())
'''
OTHER_FREEZE = "da3d9b3b1f22b312eab3a4aaa67d06abf47f2c45"   # a real commit of this repository, not the tree's


def utc_of(t):
    import datetime
    return datetime.datetime.fromtimestamp(t, datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def write_activity(bare, items):
    d = bare / "ACTIVITY"
    d.mkdir(exist_ok=True)
    (d / (VERIFY_BRANCH.replace("/", "__") + ".json")).write_text(json.dumps(items, indent=1) + "\n")


def creation(commit, t):
    return dict(activity_type="branch_creation", after=commit, before="0" * 40, ref=f"refs/heads/{VERIFY_BRANCH}",
                timestamp=utc_of(t))


def authentic_record(tmp, extra_vars=()):
    """A fresh twin with the authentic record pushed by [block verify-scan]. Returns (bare, env, hs, commit, obs)."""
    vb = vs_base(tmp)
    bare = tmp / "twin.git"
    shutil.copytree(vb["bare"], bare)
    env = twin_env(tmp, bare)
    m2 = tmp / "second_machine"
    m2.mkdir()
    dummy = lambda n, d: "0" * 64
    r2, o2 = bash_blocks(m2, env, ["second-scan"], dummy)
    (m2 / "SCAN_TO_VERIFY.json").write_bytes(vb["scan"])
    rv, ov = bash_blocks(m2, env, ["verify-scan"], dummy, extra_vars)
    got = subprocess.run(["git", "-C", str(bare), "rev-parse", "-q", "--verify", f"refs/heads/{VERIFY_BRANCH}"],
                         capture_output=True, text=True)
    commit = got.stdout.strip() if got.returncode == 0 else None
    return bare, env, hashlib.sha256(vb["scan"]).hexdigest(), commit, dict(second_scan=o2, verify=ov)


def rewrite_record(bare, tmp, edit):
    """The record commit with its files passed through edit({name: text}) -> {name: text or None (removed)}, amended
    (still one commit), pushed to the twin. Returns the new commit."""
    work = tmp / "record_edit"
    git("clone", "-q", "--branch", VERIFY_BRANCH, str(bare), str(work))
    files = {f.name: f.read_text() for f in work.iterdir() if f.is_file()}
    new = edit(dict(files))
    for n, t in new.items():
        if t is None:
            (work / n).unlink()
        elif t != files.get(n):
            (work / n).write_text(t)
    ident = ["-c", "user.name=defect test", "-c", "user.email=defect-test@localhost"]
    git("add", "-A", cwd=work)
    git(*ident, "commit", "-q", "--amend", "--no-edit", cwd=work)
    git("push", "-q", "--force", "origin", f"HEAD:refs/heads/{VERIFY_BRANCH}", cwd=work)
    return git("rev-parse", "HEAD", cwd=work).strip()


def inputs_edit(key, value):
    def edit(files):
        files["VERIFY_INPUTS.txt"] = "".join(f"{key} {value}\n" if ln.split(" ", 1)[0] == key else ln + "\n"
                                             for ln in files["VERIFY_INPUTS.txt"].splitlines())
        return files
    return edit


def lsremote_edit(name, key):
    """One branch line of the inventory `name` at the right name and another commit's sha (the sha of the twin's
    main), and the input key naming the new file's sha256, so that only the inventory check can refuse."""
    def edit(files):
        lines = files[name].splitlines()
        main = next(ln.split()[0] for ln in lines if ln.endswith("refs/heads/main"))
        i = next(i for i, ln in enumerate(lines) if not ln.endswith("refs/heads/main") and ln.split()[0] != main)
        lines[i] = main + "\t" + lines[i].split(None, 1)[1]
        files[name] = "\n".join(lines) + "\n"
        return inputs_edit(key, hashlib.sha256(files[name].encode()).hexdigest())(files)
    return edit


# kind: (what, the record's doctoring, its activity relative to its creation commit c at time t)
RECORD_KINDS = {
    None: "the authentic record (control): accepted",
    "absent": "no record branch (the owner's decisive case)",
    "other_hash": "the record naming another scan sha256 everywhere HS appears (the owner's decisive case)",
    "not_success": "the record's verdict rewritten to the failure verdict",
    "success_only": "(1) the record reduced to the single success line (VERIFY.txt alone)",
    "other_freeze": "(2) a complete record citing another freeze commit",
    "empty_freeze": "(2b) an empty F given to the read",
    "verify_lsremote_sha": "(3) VERIFY_LSREMOTE.txt with one branch at its right name and another sha",
    "scan_lsremote_sha": "(3b) the same in SCAN_LSREMOTE.txt",
    "problem_line": "(4) a PROBLEM line before the success line",
    "force_back": "(5) the branch force-pushed away and back onto its creation commit",
    "recreate": "(5b) the branch deleted and recreated on the same commit",
    "other_analysis_sha": "(6) VERIFY_INPUTS.txt naming another analysis.py sha256",
}
RECORD_ANALYSIS_ONLY = {
    "after": "the record created after the campaign announce",
    "same_time": "the record created at the announce's own push time (not strictly before)",
    "second_commit": "the record branch with a second commit on top of its creation commit",
}
RECORD_MESSAGE = {
    "absent": "the scan verify record evidence/combined-scan-verify is absent from",
    "other_hash": ("verified the scan", "is not exactly the success line"),
    "not_success": ("verdict is not success", "is not exactly the success line"),
    "success_only": ("has no VERIFY_INPUTS.txt at its creation commit", "has no VERIFY_LSREMOTE.txt at its creation",
                     "has no SCAN_LSREMOTE.txt at its creation"),
    "other_freeze": "the scan verify record cites the freeze",
    "empty_freeze": "the expected freeze commit '' is not a full 40-hex SHA",
    "verify_lsremote_sha": "VERIFY_LSREMOTE.txt is not the scan's inventory",
    "scan_lsremote_sha": "SCAN_LSREMOTE.txt is not the scan's inventory",
    "problem_line": "has a PROBLEM line",
    "force_back": "is not single-use: force_push in its activity",
    "recreate": "is not single-use: branch_deletion in its activity",
    "other_analysis_sha": "is not FREEZE_PINS.json's",
    "after": "not before the campaign announce",
    "same_time": "not before the campaign announce",
    "second_commit": "has 2 commits",
}
BLOCK_REFUSAL = "REFUSED: the published scan verify record (evidence/combined-scan-verify) does not verify HS ("


def doctor_record(tmp, kind, t_created):
    """The case's twin: the authentic record doctored by `kind`, and the twin's ACTIVITY. Returns (bare, env, hs,
    obs)."""
    bare, env, hs, c, obs = authentic_record(tmp)
    if c is None:
        return bare, env, hs, dict(obs, setup="verify-scan pushed no record")
    edit = {
        "other_hash": lambda f: {n: t.replace(hs, hashlib.sha256(b"another scan").hexdigest()) for n, t in f.items()},
        "not_success": lambda f: dict(f, **{"VERIFY.txt": f["VERIFY.txt"].replace(
            "the scan is reproduced", "THE SCAN IS NOT REPRODUCED: no announce, push nothing")}),
        "success_only": lambda f: {n: (t if n == "VERIFY.txt" else None) for n, t in f.items()},
        "other_freeze": inputs_edit("freeze_commit", OTHER_FREEZE),
        "verify_lsremote_sha": lsremote_edit("VERIFY_LSREMOTE.txt", "verify_lsremote_sha256"),
        "scan_lsremote_sha": lsremote_edit("SCAN_LSREMOTE.txt", "scan_lsremote_sha256"),
        "problem_line": lambda f: dict(f, **{"VERIFY.txt": "PROBLEM: a problem the verification found\n" + f["VERIFY.txt"]}),
        "other_analysis_sha": inputs_edit("analysis_py_sha256", hashlib.sha256(b"another analysis.py").hexdigest()),
    }.get(kind)
    if edit is not None:
        c = rewrite_record(bare, tmp, edit)
    items = [creation(c, t_created)]
    if kind == "absent":
        git("update-ref", "-d", f"refs/heads/{VERIFY_BRANCH}", cwd=bare)
        items = []
    elif kind == "force_back":
        other = git("rev-parse", "refs/heads/main", cwd=bare).strip()
        items += [dict(items[0], activity_type="force_push", after=other, before=c, timestamp=utc_of(t_created + 10)),
                  dict(items[0], activity_type="force_push", after=c, before=other, timestamp=utc_of(t_created + 20))]
    elif kind == "recreate":
        items += [dict(items[0], activity_type="branch_deletion", after="0" * 40, before=c, timestamp=utc_of(t_created + 10)),
                  dict(items[0], timestamp=utc_of(t_created + 20))]
    elif kind == "second_commit":
        work = tmp / "record_child"
        git("clone", "-q", "--branch", VERIFY_BRANCH, str(bare), str(work))
        (work / "NOTE.txt").write_text("a second commit\n")
        git("add", ".", cwd=work)
        git("-c", "user.name=defect test", "-c", "user.email=defect-test@localhost", "commit", "-q", "-m", "second",
            cwd=work)
        git("push", "-q", "origin", f"HEAD:refs/heads/{VERIFY_BRANCH}", cwd=work)
        tip = git("rev-parse", "HEAD", cwd=work).strip()
        items.append(dict(items[0], activity_type="push", after=tip, before=c, timestamp=utc_of(t_created + 10)))
    write_activity(bare, items)
    obs.update(record_commit=c, activity=[x["activity_type"] for x in items],
               record_files=sorted(git("ls-tree", "--name-only", f"refs/heads/{VERIFY_BRANCH}", cwd=bare).split())
               if kind != "absent" else [])
    return bare, env, hs, obs


def first_machine(tmp, hs_scan):
    """The first machine's folder: the twin's scan as EXCLUDED_SECOND_SCAN.json, the campaign list rebuilt by
    [block list]."""
    w, name, _ = list_case_files(tmp, "campaign", None)
    (w / "EXCLUDED_SECOND_SCAN.json").write_bytes(hs_scan)
    (w / name).unlink()
    bl = run_block(w, "list", {})
    assert bl["exit"] == 0, bl
    return w, name


RECORD_BLOCK_CONTROL = {}


def record_block_case(kind):
    """[block announce] (campaign) on the case's twin, H/HS/VS right. Exact: pushed, a /2 announce naming HS.
    Refused: exit 1, the block's REFUSED line, analysis's refusal (pinned), no announce folder, no announce ref on the
    twin. scan_byte: the scan copy with one byte changed after HS was kept."""
    def case(tmp, src):
        bare, env, hs, obs = doctor_record(tmp, kind if kind != "scan_byte" else None, time.time() - 3600)
        vb = vs_base(tmp)
        w, name = first_machine(tmp, vb["scan"])
        if kind == "scan_byte":
            b = bytearray((w / "EXCLUDED_SECOND_SCAN.json").read_bytes())
            i = b.index(b'"rule":"') + len(b'"rule":"')
            b[i] = ord("x") if b[i] != ord("x") else ord("y")
            (w / "EXCLUDED_SECOND_SCAN.json").write_bytes(bytes(b))
        shim = tmp / "twin_shim"
        shim.mkdir()
        (shim / "usercustomize.py").write_text(TWIN_SHIM)
        env = dict(env, PYTHONPATH=str(shim), LAYERED_TWIN_REMOTE=str(bare))
        fill = lambda n, d: sha(w / name) if n == "H" else hs if n in ("HS", "VS") else None
        ra, oa = bash_blocks(w, env, ["announce"], fill, ('F=""',) if kind == "empty_freeze" else ())
        pushed = subprocess.run(["git", "-C", str(bare), "rev-parse", "-q", "--verify", "refs/heads/evidence/combined-draw"],
                                capture_output=True).returncode == 0
        obs.update(announce=oa, kind=kind, HS=hs, expected=RECORD_KINDS.get(kind, kind),
                   announce_folder_made=(w / "announce_campaign").exists(), pushed_to_twin=pushed,
                   shim_lines=[x for x in oa.get("stderr", "").splitlines() if x.startswith("twin shim:")],
                   block_line=next((x for x in oa.get("stdout", "").splitlines() if "REFUSED" in x), None),
                   message=next((x for x in oa.get("stderr", "").splitlines() if x.startswith("refused:")), None))
        if ra is None:
            return False, obs
        if kind is None:
            ann = subprocess.run(["git", "-C", str(bare), "show", "refs/heads/evidence/combined-draw:DRAW_ANNOUNCE.txt"],
                                 capture_output=True, text=True).stdout
            obs["announce_pushed"] = ann
            RECORD_BLOCK_CONTROL["ok"] = ok = (ra.returncode == 0 and pushed and bool(obs["shim_lines"])
                                               and f"second_scan_sha256 {hs}\n" in ann and not oa["unknown_placeholders"])
            return ok, obs
        obs["control_passed"] = RECORD_BLOCK_CONTROL.get("ok", False)
        if kind == "scan_byte":
            obs["message"] = obs["block_line"]
            ok = ra.returncode != 0 and obs["block_line"] is not None
        else:
            ok = ra.returncode == 1 and (obs["block_line"] or "").startswith(BLOCK_REFUSAL)
        ok = ok and not obs["announce_folder_made"] and not pushed
        obs["refused_before_announce"] = ok
        return ok and obs["control_passed"], obs
    case.__name__ = f"case_record_block_{kind or 'exact'}"
    return case


RECORD_FUNC = '''import json, sys, tempfile, traceback
sys.path.insert(0, sys.argv[1])
import analysis as A
a = json.loads(sys.argv[2])
files = {k: (None if v is None else open(v, "rb").read()) for k, v in a["files"].items()}
ann = open(a["announce"], "rb").read()
A.announce_on_github = lambda branch, outdir, files_=None, **k: (a["commit"], ann, a["push_utc"], files)
A.freeze_time = lambda tree_commit, outdir: "2026-11-01T00:00:00Z"
A.verify_remote = lambda: a["record_remote"]
out = dict(reached="check_draw")
try:
    d, info, _ = A.check_draw(a["kw"], "campaign", tempfile.mkdtemp(), a["tree"])
    out.update(reached="accepted", refused=False, scan_verify=info.get("scan_verify"))
except A.Refused as e:
    tb = traceback.extract_tb(e.__traceback__)
    out.update(refused=True, message=str(e), stack=[f.name for f in tb])
print(json.dumps(out))
'''
RECORD_FUNC_CONTROL = {}
COMMIT_KINDS = {
    None: "the announce commit holds the announced EXCLUDED_PUBLISHED.json and EXCLUDED_SECOND_SCAN.json (control)",
    "no_scan": "the announce commit has no EXCLUDED_SECOND_SCAN.json: refused",
    "scan_differs": "the announce commit's EXCLUDED_SECOND_SCAN.json (announced) is not byte-equal to second_scan=: refused",
}


def record_analysis_run(tmp, kind=None, commit_kind=None):
    """check_draw(kw, "campaign", outdir, F) on its GitHub path: announce_on_github and freeze_time stand-ins (the
    announce commit's files), verify_remote the case's twin (record_created reads its ACTIVITY). The campaign's list is
    rebuilt from the twin's scan, the /2 announce names it; the record is created 1 h before the announce unless kind
    says otherwise. F is this tree's HEAD (the freeze the record cites), "" for empty_freeze."""
    sys.path.insert(0, str(HERE))
    import draw_seeds as DS
    vb = vs_base(tmp)
    w, name = first_machine(tmp, vb["scan"])
    scan = w / "EXCLUDED_SECOND_SCAN.json"
    eb = (w / name).read_bytes()
    files = {"EXCLUDED_PUBLISHED.json": str(w / name), "EXCLUDED_SECOND_SCAN.json": str(scan)}
    named = scan
    if commit_kind == "no_scan":
        files["EXCLUDED_SECOND_SCAN.json"] = None
    elif commit_kind == "scan_differs":
        other = w / "SCAN_IN_COMMIT.json"
        o = json.loads(scan.read_bytes())
        other.write_bytes(DS.canon(regen(o, o["seeds"] + [1000099])))
        files["EXCLUDED_SECOND_SCAN.json"] = named = other
    _, p, t0 = announced_draw(w, "CASE", ROUND_C, json.loads(eb), eb, CAMPAIGN_SIZES, "campaign",
                              "evidence/combined-draw", fmt=2, second_scan_sha256=sha(named))
    created = {"after": t0 + 60, "same_time": t0}.get(kind, t0 - 3600)
    bare, env, hs, obs = doctor_record(tmp, kind, created)
    d = json.loads(Path(p["draw"]).read_text())
    tree = "" if kind == "empty_freeze" else git("rev-parse", "HEAD", cwd=HERE).strip()
    kw = dict(draw=str(p["draw"]), excluded=str(w / name), **{SECOND_SCAN_ARG: str(scan)})
    r = subprocess.run([PY, "-B", "-c", RECORD_FUNC, str(HERE), json.dumps(dict(
        kw=kw, files={k: (None if v is None else str(v)) for k, v in files.items()}, announce=str(p["announce"]),
        commit=d["announce"]["commit"], push_utc=d["announce"]["push_utc"], record_remote=str(bare), tree=tree))],
        capture_output=True, text=True)
    try:
        res = json.loads(r.stdout.strip().splitlines()[-1])
    except (ValueError, IndexError):
        res = dict(crashed=True, stderr=r.stderr[-1500:])
    obs.update(HS=hs, announce_push=d["announce"]["push_utc"], record_created=utc_of(created), tree=tree, **res)
    return res, obs


def record_func_case(kind):
    def case(tmp, src):
        res, obs = record_analysis_run(tmp, kind)
        obs["expected"] = RECORD_KINDS.get(kind) or RECORD_ANALYSIS_ONLY.get(kind)
        if kind is None:
            RECORD_FUNC_CONTROL["ok"] = ok = res.get("reached") == "accepted" and bool(res.get("scan_verify"))
            return ok, obs
        obs["control_passed"] = RECORD_FUNC_CONTROL.get("ok", False)
        return res.get("refused") is True and obs["control_passed"], obs
    case.__name__ = f"case_record_analysis_{kind or 'exact'}"
    return case


COMMIT_CONTROL = {}


def announce_commit_case(kind):
    def case(tmp, src):
        res, obs = record_analysis_run(tmp, None, kind)
        obs["expected_check"] = COMMIT_KINDS[kind]
        if kind is None:
            COMMIT_CONTROL["ok"] = ok = res.get("reached") == "accepted"
            return ok, obs
        obs["control_passed"] = COMMIT_CONTROL.get("ok", False)
        return res.get("refused") is True and obs["control_passed"], obs
    case.__name__ = f"case_announce_commit_{kind or 'exact'}"
    return case


def case_verify_scan_empty_freeze(tmp, src):
    """(2b) [block verify-scan] with an empty F: refused before any record (no record branch on the twin)."""
    bare, env, hs, c, obs = authentic_record(tmp, ('F=""',))
    v = obs["verify"]
    obs["message"] = next((x for x in v.get("stdout", "").splitlines() if "REFUSED" in x), None)
    return v.get("exit") == 1 and c is None and (obs["message"] or "").startswith("REFUSED: F () is not"), obs



# INTEGRATION: each case that depends on a passing control must reach the specific check it exercises. Its refusal
# must carry that check's words (the stable part of the analysis's message, at the fix's tip); a refusal by any
# earlier check fails the case. The accepted cases (exit 0) are checked by their own assertions.
REACHES = {
    "standin_seed_changed": "is not draw_seeds.draw of its beacon and round",
    "standin_round_off_by_one": "is not the round the announce's push time fixes",
    "standin_signature_byte": "must both be exactly sha256(signature)",
    "standin_excluded_not_superset": "is not a superset of the freeze's EXCLUDED.json",
    "standin_excluded_sha_differs": "is not the one DRAW_ANNOUNCE.txt names",
    **{f"standin_beacon_{w}": "must both be exactly sha256(signature)" for w in ("upper", "mixed", "spaces", "0x")},
    **{f"standin_signature_{k}": "not written in canonical form" for k in ("pad00", "pad0000", "pad000000")},
    "standin_signature_flip": "does not verify against the pinned quicknet key",
    "standin_signature_other_round": "'signature_ok': False",
    "standin_activity_redone": "(branch_deletion in its activity)",
    "standin_activity_force_push": "(force_push in its activity)",
    "rehearsal_seed_missing": "list lacks rehearsal",           # "rehearsal seeds [" at 04d05b47, "rehearsal2 seeds [" at 8b5c9f95
    "rehearsal_noise_missing": "and noise seeds [",
    "rehearsal_announce_later": "is not earlier than the campaign's",
}

# The L cases' refusals, pinned to the messages of analysis.py at a5ba132b (the exact union), the same for the blocks
# (which call analysis's checks) and the functions. r2_extra and the /2 format cases await the follow-ups: not pinned.
